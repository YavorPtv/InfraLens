{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectTestAssetBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::cdk-hnb659fds-assets-230944684535-eu-central-1",
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "230944684535"
        }
      }
    },
    {
      "Sid": "PublishTestFileAssets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::cdk-hnb659fds-assets-230944684535-eu-central-1/*",
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "230944684535"
        }
      }
    }
  ]
}
