{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadApplicationAndBootstrap",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ListChangeSets",
        "cloudformation:DescribeStackResource"
      ],
      "Resource": [
        "arn:aws:cloudformation:eu-central-1:230944684535:stack/InfraLensTestStack/*",
        "arn:aws:cloudformation:eu-central-1:230944684535:stack/CDKToolkit/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ReadBootstrapVersion",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:eu-central-1:230944684535:parameter/cdk-bootstrap/hnb659fds/version",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ReadDeploymentDiagnostics",
      "Effect": "Allow",
      "Action": [
        "cloudformation:GetHookResult",
        "cloudformation:ValidateTemplate"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ReadChangeSetEvents",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeEvents"
      ],
      "Resource": [
        "arn:aws:cloudformation:eu-central-1:230944684535:stack/InfraLensTestStack/*",
        "arn:aws:cloudformation:eu-central-1:230944684535:changeSet/cdk-deploy-change-set/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "PrepareApplicationChanges",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack"
      ],
      "Resource": "arn:aws:cloudformation:eu-central-1:230944684535:stack/InfraLensTestStack/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "cloudformation:RoleArn": "arn:aws:iam::230944684535:role/cdk-hnb659fds-cfn-exec-role-230944684535-eu-central-1"
        }
      }
    },
    {
      "Sid": "ApplyOrRollbackApplicationChanges",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:RollbackStack",
        "cloudformation:ContinueUpdateRollback"
      ],
      "Resource": "arn:aws:cloudformation:eu-central-1:230944684535:stack/InfraLensTestStack/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "PassOnlyTestExecutionRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::230944684535:role/cdk-hnb659fds-cfn-exec-role-230944684535-eu-central-1",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadStagedAssets",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::cdk-hnb659fds-assets-230944684535-eu-central-1"
    },
    {
      "Sid": "ReadStagedObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::cdk-hnb659fds-assets-230944684535-eu-central-1/*"
    },
    {
      "Sid": "KeepTeardownAndBootstrapAdministrationSeparate",
      "Effect": "Deny",
      "Action": [
        "cloudformation:DeleteStack",
        "cloudformation:UpdateTerminationProtection",
        "cloudformation:CreateStackRefactor",
        "cloudformation:ExecuteStackRefactor"
      ],
      "Resource": "*"
    }
  ]
}
