{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Nested upload and import evidence fixture; not deployed by tests.",
  "Resources": {
    "OrdersFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "nodejs20.x",
        "Handler": "src/orders/handler.handler",
        "Role": {
          "Fn::GetAtt": [
            "OrdersRole",
            "Arn"
          ]
        },
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "OrdersTable"
            }
          }
        },
        "Code": {
          "ZipFile": "exports.handler = async () => {};"
        }
      }
    },
    "OrdersRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "OrdersAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:*",
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "AuditFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "nodejs20.x",
        "Handler": "src/audit/handler.handler",
        "Role": {
          "Fn::GetAtt": [
            "AuditRole",
            "Arn"
          ]
        },
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "OrdersTable"
            }
          }
        },
        "Code": {
          "ZipFile": "exports.handler = async () => {};"
        }
      }
    },
    "AuditRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "AuditAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:*",
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "PaymentsFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "nodejs20.x",
        "Handler": "src/payments/handler.handler",
        "Role": {
          "Fn::GetAtt": [
            "PaymentsRole",
            "Arn"
          ]
        },
        "Environment": {
          "Variables": {
            "QUEUE_URL": {
              "Ref": "PaymentsQueue"
            }
          }
        },
        "Code": {
          "ZipFile": "exports.handler = async () => {};"
        }
      }
    },
    "PaymentsRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "PaymentsAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "sqs:*",
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "OrdersTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "id",
            "KeyType": "HASH"
          }
        ]
      }
    },
    "PaymentsQueue": {
      "Type": "AWS::SQS::Queue"
    }
  }
}
